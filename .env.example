# Banco SQLite local (o arquivo será criado na pasta prisma)
DATABASE_URL="file:./dev.db"
# Gere um valor longo e aleatório para proteger as sessões.
NEXTAUTH_SECRET="substitua-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Recuperação de senha por e-mail (Resend). Use um remetente verificado no provedor.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Meu Financeiro <seguranca@seu-dominio.com>"
# Habilite apenas quando o proxy reverso sobrescrever os cabeçalhos de IP enviados pelo cliente.
TRUST_PROXY_HEADERS="false"
