datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  cards        PaymentCard[]
  categories   Category[]
  institutions FinancialInstitution[]
}

model Category {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  entity      String   @default("ALL")
  createdAt   DateTime @default(now())
  @@unique([userId, name, entity])
}

model FinancialInstitution {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  institution   String
  accountType   String        @default("CHECKING")
  entity        String        @default("PHYSICAL")
  initialBalance Float       @default(0)
  createdAt     DateTime      @default(now())
  transactions  Transaction[]
}

model PaymentCard {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  paymentType String   @default("CREDIT")
  brand       String?
  lastFour    String?
  creditLimit Float?
  closingDay  Int?
  dueDay      Int?
  createdAt   DateTime @default(now())
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  type        String   @default("EXPENSE")
  entity      String   @default("PHYSICAL")
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  status      String   @default("PAID")
  recurrence  String?
  recurrenceGroup String?
  recurrenceEndDate DateTime?
  installmentGroup String?
  installmentNumber Int?
  installmentTotal Int?
  cardId      String?
  card        PaymentCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  accountId   String?
  account     FinancialInstitution? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  purpose     String   @default("STANDARD")
  autoDebit   Boolean  @default(false)
  isSubscription Boolean @default(false)
  notes       String?
}
