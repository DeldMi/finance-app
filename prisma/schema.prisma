datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  cards        PaymentCard[]
}

model PaymentCard {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  brand       String?
  lastFour    String?
  creditLimit Float?
  closingDay  Int?
  dueDay      Int?
  createdAt   DateTime @default(now())
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  type        String   @default("EXPENSE")
  entity      String   @default("PHYSICAL")
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  status      String   @default("PAID")
  recurrence  String?
  installmentGroup String?
  installmentNumber Int?
  installmentTotal Int?
  cardId      String?
  card        PaymentCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
}
